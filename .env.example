# SQLite database file (relative to the project root)
DATABASE_URL="file:./dev.db"

# Public URL of the app, used for Stripe redirect URLs
APP_URL="http://localhost:3000"

# Stripe (test mode keys work for development).
# Leave STRIPE_SECRET_KEY empty to run in demo mode, where payments are simulated.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Commission taken from the owner's share of each rental (never from deposits)
PLATFORM_FEE_PERCENT="10"

# Where uploaded listing photos are stored
UPLOAD_DIR="./uploads"

# Shared secret for calling /api/cron/sweep from a scheduler
CRON_SECRET=""
